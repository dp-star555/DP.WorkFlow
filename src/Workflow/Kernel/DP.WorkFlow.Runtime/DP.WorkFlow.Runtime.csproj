<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DP.WorkFlow.Abstractions\DP.WorkFlow.Abstractions.csproj" />
    <ProjectReference Include="..\DP.WorkFlow.Core\DP.WorkFlow.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>$(WorkflowTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 记录链路的"无空唤醒"是资源性质，无法从 Sink 侧观察；开放内部诊断给测试工程。 -->
    <InternalsVisibleTo Include="DP.WorkFlow.Runtime.Tests" />
    <!-- 事件流规则核对（R5-a）通过内部探针收集事件，只在测试中启用。 -->
    <InternalsVisibleTo Include="DP.WorkFlow.Testing" />
  </ItemGroup>

</Project>
