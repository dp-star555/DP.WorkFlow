<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 构建真实插件，不让测试宿主引用新契约/节点/引擎。 -->
    <ProjectReference Include="../../PluginFixtures/Intensity.Engine/Intensity.Engine.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="../../PluginFixtures/Intensity.Nodes/Intensity.Nodes.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup><Using Include="Xunit" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Workflow/Nodes/DP.WorkFlow.Nodes.Vision/DP.WorkFlow.Nodes.Vision.csproj" />
    <ProjectReference Include="../../../src/Workflow/Nodes/DP.WorkFlow.Nodes.Composite/DP.WorkFlow.Nodes.Composite.csproj" />
    <ProjectReference Include="../../../src/Workflow/Kernel/DP.WorkFlow.Runtime/DP.WorkFlow.Runtime.csproj" />
    <ProjectReference Include="../../../src/Workflow/Persistence/DP.WorkFlow.Persistence.Json/DP.WorkFlow.Persistence.Json.csproj" />
  </ItemGroup>
  <Target Name="CleanupPluginTestRuns" BeforeTargets="Build">
    <RemoveDir Directories="$(OutDir)PluginTestRuns" />
  </Target>
</Project>
