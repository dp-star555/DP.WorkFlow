<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 采集Provider插件包目录；目标框架必须与各厂商工程的对应输出一致。 -->
    <VisionAcquisitionPluginTfm>net8.0-windows</VisionAcquisitionPluginTfm>
    <HalconPluginRoot>$(MSBuildThisFileDirectory)..\..\..\DP.Vision\src\DP.Vision.Halcon\</HalconPluginRoot>
    <BaslerPluginRoot>$(MSBuildThisFileDirectory)..\..\..\DP.Vision\src\DP.Vision.Basler\</BaslerPluginRoot>
  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\DP.Vision\src\DP.Vision.Acquisition.Runtime\DP.Vision.Acquisition.Runtime.csproj" />
    <!-- 只保证两个厂商插件被构建并投放到插件目录；不加编译期引用，
         宿主因此无法在编译期选择具体Provider（阶段D/E的验收项）。 -->
    <ProjectReference Include="..\..\..\DP.Vision\src\DP.Vision.Halcon\DP.Vision.Halcon.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\DP.Vision\src\DP.Vision.Basler\DP.Vision.Basler.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\..\DP.Vision\src\DP.Vision.OpenCv\DP.Vision.OpenCv.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\Workflow\Kernel\DP.WorkFlow.Abstractions\DP.WorkFlow.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Kernel\DP.WorkFlow.Core\DP.WorkFlow.Core.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Nodes\DP.WorkFlow.Nodes.Composite\DP.WorkFlow.Nodes.Composite.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Nodes\DP.WorkFlow.Nodes.Motion\DP.WorkFlow.Nodes.Motion.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Nodes\DP.WorkFlow.Nodes.Process\DP.WorkFlow.Nodes.Process.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Nodes\DP.WorkFlow.Nodes.Standard\DP.WorkFlow.Nodes.Standard.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Nodes\DP.WorkFlow.Nodes.Vision\DP.WorkFlow.Nodes.Vision.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Persistence\DP.WorkFlow.Persistence.Json\DP.WorkFlow.Persistence.Json.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Kernel\DP.WorkFlow.Runtime\DP.WorkFlow.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Studio\DP.WorkFlow.UI.Shared\DP.WorkFlow.UI.Shared.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Studio\DP.WorkFlow.UI.WinForms\DP.WorkFlow.UI.WinForms.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Studio\DP.WorkFlow.Process.UI.WinForms\DP.WorkFlow.Process.UI.WinForms.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Studio\DP.WorkFlow.Vision.UI\DP.WorkFlow.Vision.UI.csproj" />
    <ProjectReference Include="..\..\src\Workflow\Studio\DP.WorkFlow.Vision.UI.WinForms\DP.WorkFlow.Vision.UI.WinForms.csproj" />
  </ItemGroup>

  <!--
    把厂商插件按包结构投放到 plugins/<pluginId>/，使宿主只通过目录发现Provider。

    插件包必须自包含厂商依赖：加载器用 Assembly.GetExportedTypes() 发现入口，这要求插件程序集的
    引用全部可解析（HALCON 需要 halcondotnet.dll，Basler 需要 Basler.Pylon.dll）。而
    ReferenceOutputAssembly="false" 恰好不会把厂商依赖带进宿主根目录，所以这些文件必须显式投放。

    但**不能**把宿主已提供的契约程序集（DP.Vision.dll、DP.Vision.Acquisition.Abstractions.dll）
    放进插件包：那会让插件拿到第二份契约类型，与宿主的中立接口不是同一个类型，组合阶段必然失败。

    插件包**不投放 plugin.json**：发现依据是"程序集里存在实现 IVisionAcquisitionDriverModule 的
    公开类型"，Manifest 不是加载依据。留一个没人读的 Manifest 只会让人以为它还在生效。
  -->
  <Target Name="StageVisionAcquisitionProviderPlugins" AfterTargets="Build">
    <ItemGroup>
      <HalconProviderPayload Include="$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\*.dll"
                             Exclude="$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.dll;$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Acquisition.Abstractions.dll;$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Algorithms.dll" />
      <HalconProviderPayload Include="$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Halcon.deps.json" />
      <HalconProviderPayload Include="$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\*.pdb"
                             Exclude="$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.pdb;$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Acquisition.Abstractions.pdb;$(HalconPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Algorithms.pdb" />
      <BaslerProviderPayload Include="$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\*.dll"
                             Exclude="$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.dll;$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Acquisition.Abstractions.dll" />
      <BaslerProviderPayload Include="$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\*.pdb"
                             Exclude="$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.pdb;$(BaslerPluginRoot)bin\$(Configuration)\$(VisionAcquisitionPluginTfm)\DP.Vision.Acquisition.Abstractions.pdb" />
    </ItemGroup>
    <!-- 旧版本曾把共享算法契约复制进包；升级时清理这些生成文件，避免残留旧身份。 -->
    <Delete Files="$(OutDir)plugins\dp.vision.halcon\DP.Vision.Algorithms.dll;$(OutDir)plugins\dp.vision.halcon\DP.Vision.Algorithms.pdb" />
    <Copy SourceFiles="@(HalconProviderPayload)"
          DestinationFolder="$(OutDir)plugins\dp.vision.halcon"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BaslerProviderPayload)"
          DestinationFolder="$(OutDir)plugins\dp.vision.basler"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Compile Include="..\VisionData\WorkflowImageDemo.cs" Link="WorkflowImageDemo.cs" />
    <Compile Include="..\Recovery\WorkflowRecoveryDemo.cs" Link="WorkflowRecoveryDemo.cs" />
    <Content Include="..\VisionData\demo.pgm" Link="VisionData\demo.pgm" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\VisionData\AlgorithmPlugins.targets" />
</Project>
