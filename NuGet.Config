<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 与 DP.Foundation 共用同一份 ModernUI（vendor/packages 里的包从 DP.Foundation/vendor/packages 复制）。 -->
    <add key="shared-modernui" value="vendor/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="shared-modernui">
      <package pattern="ModernUI.*" />
    </packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
